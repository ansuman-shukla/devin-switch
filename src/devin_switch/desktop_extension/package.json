{
  "name": "panels",
  "displayName": "Switch Panels",
  "description": "Live whiteboard, agent browser and running subagents beside the chat.",
  "version": "0.2.0",
  "publisher": "devin-switch",
  "license": "Apache-2.0",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other"],
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      { "command": "switchPanels.openCanvas", "title": "Open Whiteboard", "category": "Switch" },
      { "command": "switchPanels.openBrowser", "title": "Open Agent Browser", "category": "Switch" },
      { "command": "switchPanels.showSubagents", "title": "Show Running Subagents", "category": "Switch" }
    ],
    "configuration": {
      "title": "Switch Panels",
      "properties": {
        "switchPanels.whiteboardHome": {
          "type": "string",
          "default": "",
          "description": "whiteboard-mcp state folder (default: WHITEBOARD_HOME or ~/.whiteboard-mcp)."
        }
      }
    }
  }
}
